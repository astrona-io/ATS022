{
  "context": "kind-astro-ats-022-playground-010-01",
  "resources": [
    {
      "kind": "storageclass",
      "name": "training-local",
      "namespace": "",
      "expected": {
        "apiVersion": "storage.k8s.io/v1",
        "kind": "StorageClass",
        "metadata": {
          "name": "training-local"
        },
        "provisioner": "rancher.io/local-path",
        "volumeBindingMode": "WaitForFirstConsumer",
        "reclaimPolicy": "Retain"
      }
    },
    {
      "kind": "persistentvolumeclaim",
      "name": "class-data",
      "namespace": "starfleet",
      "expected": {
        "apiVersion": "v1",
        "kind": "PersistentVolumeClaim",
        "metadata": {
          "name": "class-data",
          "namespace": "starfleet"
        },
        "spec": {
          "storageClassName": "training-local",
          "accessModes": [
            "ReadWriteOnce"
          ],
          "resources": {
            "requests": {
              "storage": "128Mi"
            }
          }
        }
      },
      "state": "pvc"
    },
    {
      "kind": "pod",
      "name": "class-reader",
      "namespace": "starfleet",
      "expected": {
        "apiVersion": "v1",
        "kind": "Pod",
        "metadata": {
          "name": "class-reader",
          "namespace": "starfleet"
        },
        "spec": {
          "restartPolicy": "Never",
          "containers": [
            {
              "name": "reader",
              "image": "docker.io/library/busybox:1.37.0",
              "command": [
                "sh",
                "-c",
                "sleep 3600"
              ],
              "volumeMounts": [
                {
                  "name": "data",
                  "mountPath": "/data"
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "data",
              "persistentVolumeClaim": {
                "claimName": "class-data"
              }
            }
          ]
        }
      },
      "state": "pod"
    }
  ],
  "behavior": [
    {
      "args": [
        "kubectl",
        "-n",
        "starfleet",
        "exec",
        "class-reader",
        "--",
        "sh",
        "-c",
        "printf stored > /data/result && cat /data/result"
      ],
      "equals": "stored"
    }
  ]
}
